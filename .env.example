# Copy this file to .env and replace the example values. Never commit .env.
# Generate a long, random value for ROADGUARD_SECRET_KEY.
ROADGUARD_SECRET_KEY=replace-with-a-long-random-secret

# Full path to a Firebase Admin service-account JSON file stored OUTSIDE this repository.
# Use forward slashes on Windows, for example C:/RoadGuard-Secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=C:/RoadGuard-Secrets/firebase-service-account.json

# false for local http://127.0.0.1:5000 development; true only when deployed with HTTPS.
COOKIE_SECURE=false
PORT=5000
